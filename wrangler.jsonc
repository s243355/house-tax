{
  "name": "house-tax",
  "compatibility_date": "2025-01-01",
  "main": "_worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "tcyucheng.com", "custom_domain": true },
    { "pattern": "www.tcyucheng.com", "custom_domain": true }
  ],
  "vars": {
    "GA_MEASUREMENT_ID": "G-GF9EYGTLNG"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
